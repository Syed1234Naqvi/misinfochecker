{
  "manifest_version": 3,
  "name": "Auto Text Analyzer",
  "version": "1.0",
  "permissions": [
    "activeTab",
    "scripting",
	"storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": "icon.png",
    "default_title": "Auto Text Analyzer"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["contentScript.js"]
    }
  ]
}
